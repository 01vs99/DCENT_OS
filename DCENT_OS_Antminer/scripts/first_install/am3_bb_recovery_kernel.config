# Linux 5.4.242, merged over omap2plus_defconfig by the isolated recovery
# producer. This is a RAM recovery kernel; no mining or power-control driver.
CONFIG_LOCALVERSION="-dcent-bb-recovery"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_ADDRESS=y
CONFIG_PROC_DEVICETREE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_OF_PARTS=y
# CONFIG_MTD_CMDLINE_PARTS is not set
# CONFIG_MTD_PARTITIONED_MASTER is not set
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD_NAND_OMAP2=y
CONFIG_MTD_NAND_OMAP_BCH=y
CONFIG_OMAP_GPMC=y
CONFIG_MTD_NAND_ECC_SW_BCH=y
CONFIG_BCH=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_OMAP_HS=y
CONFIG_VFAT_FS=y
CONFIG_EXT4_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_TI_CPSW=y
CONFIG_TI_CPTS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_OMAP=y
CONFIG_TMPFS=y
# CONFIG_CMDLINE_FORCE is not set
CONFIG_CMDLINE=""
