#!/bin/sh
# Early init owns the qualified mounts; service startup only revalidates them.
case "${1:-}" in
    start) exec /usr/bin/python3 -I /usr/libexec/dcentos/classic-aml-storage.py check ;;
    stop) exit 0 ;; # PID1 unmounts filesystems after all owners have stopped.
    *) echo "Usage: $0 {start|stop}" >&2; exit 1 ;;
esac
