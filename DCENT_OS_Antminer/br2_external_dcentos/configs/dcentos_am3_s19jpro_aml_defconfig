# DCENT_OS classic S19j Pro Amlogic image (am3-s19jpro-aml).
# Target A113D, aarch64; BHB42601/21/41, BM1362, 126 ASICs per selected board.
# Retained current-boot factory identity + classic application firmware0x89,
# APW12 versions75..77, PIC LM75 supervision, GPIO437 raw0ON/raw1OFF.
# BL2 -> FIP -> U-Boot2015.01 -> kernel4.9.113; no FPGA bitstream.
# Shared package/architecture content is provided by the existing common and
# Amlogic fragments. Physical BETA qualification remains a separate receipt.

# =============================================================================
# Per-product identity.
# =============================================================================
BR2_TARGET_GENERIC_HOSTNAME="dcentos-s19jpro-aml"
BR2_PACKAGE_MTD_UBIATTACH=y
BR2_TARGET_GENERIC_ISSUE="DCENTos for S19j Pro (classic AML fw89) - D-Central Technologies"

# =============================================================================
# Overlay-on-overlay — shared amlogic overlay first, am3-s19jpro-aml identity
# last. Buildroot applies overlays left-to-right; the last write wins.
# =============================================================================
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_DCENTOS_PATH)/board/common/rootfs-overlay $(BR2_EXTERNAL_DCENTOS_PATH)/board/amlogic/rootfs-overlay $(BR2_EXTERNAL_DCENTOS_PATH)/board/amlogic/am3-s19jpro-aml/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_DCENTOS_PATH)/board/amlogic/am3-s19jpro-aml/post-build.sh $(BR2_EXTERNAL_DCENTOS_PATH)/board/common/prune-runtime-research-tools.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_DCENTOS_PATH)/board/amlogic/am3-s19jpro-aml/post-image.sh"
